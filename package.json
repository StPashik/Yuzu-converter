{
  "name": "@stpashik/yuzu-converter",
  "version": "0.6.1",
  "description": "Install and launch the native Yuzu Converter menu bar app for macOS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StPashik/Yuzu-converter.git"
  },
  "homepage": "https://github.com/StPashik/Yuzu-converter#readme",
  "type": "module",
  "engines": { "node": ">=20.11" },
  "os": ["darwin"],
  "cpu": ["arm64", "x64"],
  "bin": { "yuzu-converter": "npm/cli.mjs" },
  "files": ["npm/", "README.md", "LICENSE"],
  "scripts": {
    "postinstall": "node npm/install.mjs",
    "prepack": "node npm/validate-release.mjs",
    "prepare:release": "node scripts/prepare-npm.mjs",
    "test": "node --test Tests/npm/*.test.mjs Tests/release/*.test.mjs",
    "test:release": "node --test Tests/release/*.test.mjs",
    "test:installer": "node --test Tests/npm/*.test.mjs"
  }
}
